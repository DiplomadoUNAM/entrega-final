# Puertos publicados en el equipo
APP_PORT=8000
FRONTEND_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=3307
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# Credenciales de MariaDB: usa los mismos valores que Backend/.env
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_SEGURA

# Usuario y grupo del proceso dentro del contenedor
WWWUSER=1000
WWWGROUP=1000

# Configuración opcional de depuración
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# Nombre del volumen persistente de MariaDB
DB_VOLUME_NAME=practica-final_sail-mariadb
